# Local dev secrets for `wrangler pages dev` — copy to .dev.vars (gitignored)
# and fill in real values. NEVER commit .dev.vars.

# Sign-tokens secret. Generate with: openssl rand -base64 32
# Same value must persist across environments where the SAME user signs in
# (or sessions break across env). Stored separately in CF Pages env vars
# (Production + Preview) for non-local deploys.
BETTER_AUTH_SECRET=<32+byte-secret>

# Canonical app origin — better-auth uses this to construct magic-link URLs
# and to validate the request origin. Local dev: http://localhost:8788 is
# the default `wrangler pages dev` port. Production: the pages.dev URL or
# the custom domain when configured.
BETTER_AUTH_URL=http://localhost:8788

# Email sender provider for magic-link. Pilot default: 'resend' (REST direct
# via api.resend.com). 'cf-email' is deferred to sub-slice (d) when the
# Cloudflare Email Service exits BETA. See functions/_lib/sender.js.
SENDER_PROVIDER=resend

# Resend REST API key. Bearer token for POST https://api.resend.com/emails.
# Provision in the Resend dashboard. Pilot uses Resend's shared
# onboarding@resend.dev sender (see FROM_EMAIL below), which is restricted
# to sending to the Resend account-owner's email until a domain is verified.
RESEND_API_KEY=<resend-api-key>

# Sender address used in the `from` field of outbound magic-link emails.
# Pilot default: onboarding@resend.dev — Resend's documented public test
# sender (non-secret). Swap to a verified-domain address before broad pilot.
FROM_EMAIL=onboarding@resend.dev
